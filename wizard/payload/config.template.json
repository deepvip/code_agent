{
  "username": "Open",
  "share": "disabled",
  "update": "disable",
  "default_agent": "build",
  "model": "aero/__MODEL_ID__",
  "providers": {
    "aero": {
      "name": "Open AI",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "__BASE_URL__",
        "apiKey": "__API_KEY__",
        "timeout": 600000,
        "headerTimeout": 60000,
        "chunkTimeout": 120000
      },
      "models": {
        "__MODEL_ID__": {
          "name": "__MODEL_NAME__",
          "limit": {
            "context": 200000,
            "input": 180000,
            "output": 32000
          },
          "cost": {
            "input": 0.5,
            "output": 2
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "temperature": true
          }
        }
      }
    }
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "aero",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "allow"
    }
  ],
  "permissions": [
    {
      "action": "read",
      "resource": "*/.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.key",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*id_rsa*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/credentials*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*/.git/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*/.github/workflows/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*/prod/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*/production/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push --force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push -f*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf /*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "curl *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "wget *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset --hard*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "npm publish*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "kubectl *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "docker *",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*/pom.xml",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*/go.mod",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*/package.json",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "opencode",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "report",
      "effect": "deny"
    }
  ],
  "agents": {
    "build": {
      "description": "Open 研发助手：实现功能、修复缺陷",
      "system": "你是 Open 内部研发助手。遵守公司编码规范；改动前先给出简短计划；改动后必须运行相关测试或给出无法运行的原因；不要编造不存在的 API 或依赖；涉及生产配置、密钥、发布操作时必须先征求确认。"
    },
    "review": {
      "description": "只读代码评审，输出结构化意见",
      "mode": "subagent",
      "system": "你是严格的代码评审者。只读不改。按「正确性 / 安全 / 可维护性 / 测试覆盖」四类输出问题，每条给出文件、行号、原因与修复建议。没有问题的类别写「无」。",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "migrate": {
      "description": "受限的批量迁移代理：可改代码，禁止提交与发布",
      "mode": "subagent",
      "system": "你负责按迁移手册批量改造代码。每次只处理一个模块，改完立即运行该模块的测试。禁止执行 git push、发布、部署类命令。",
      "permissions": [
        {
          "action": "shell",
          "resource": "git push*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "npm publish*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "kubectl *",
          "effect": "deny"
        }
      ]
    },
    "docs": {
      "description": "文档与注释生成",
      "mode": "subagent",
      "system": "你是文档工程师。输出中文技术文档，结构清晰，术语与公司内部一致；不修改业务逻辑代码，只写文档与注释。",
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
  "commands": {
    "review": {
      "description": "评审当前改动",
      "agent": "review",
      "template": "评审当前工作区的改动。先运行 git diff 查看变更，再按正确性/安全/可维护性/测试覆盖给出问题清单。"
    },
    "test": {
      "description": "为改动的文件补测试并运行",
      "template": "为当前工作区改动的源文件补充单元测试，然后运行测试并修复失败项。不要修改与本次改动无关的文件。"
    },
    "explain": {
      "description": "解释一段代码或一个目录",
      "template": "解释 $ARGUMENTS 的实现思路：入口、关键数据结构、调用链、可能的坑。用中文回答，控制在 300 字以内。"
    }
  },
  "snapshots": true,
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": 20000
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "watcher": {
    "ignore": [
      "dist/**",
      "build/**",
      "coverage/**",
      "node_modules/**",
      ".git/**"
    ]
  },
  "formatter": true,
  "mcp": {
    "servers": {}
  },
  "plugins": [],
  "experimental": {
    "todo": true,
    "subagent_depth": 2
  }
}
